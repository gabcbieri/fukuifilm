---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="FUKUIFILM | Projetos" description="Fotografia, campanhas, filmes e dire??o visual com presen?a, mem?ria e sofistica??o.">

  <nav class="floating-menu">

    <div class="menu-contents">

      <!-- LOGO ESQUERDA -->
      <a href="index.html" class="menu-brand">
        <img src="img/FUKUIFILM-HORIZONTAL-BRANCO.webp" alt="FUKUIFILM" class="menu-logo" loading="eager" fetchpriority="high">
      </a>

      <!-- MENU CENTRO -->
      <ul id="main-navigation">
        <li><a href="index.html">Início</a></li>
        <li><a href="#projects-section">Projetos</a></li>
        <li><a href="#films-section">Em foco</a></li>
      </ul>

      <!-- DIREITA -->
      <div class="menu-right">

        <a href="https://www.instagram.com/fukuifilm/" target="_blank" rel="noopener noreferrer" class="menu-instagram">
          <i class="fab fa-instagram"></i>
        </a>

        <a class="budget-btn" href="https://wa.me/5547999988082" target="_blank" rel="noopener noreferrer">
          Solicitar orçamento
        </a>

        <!-- HAMBURGUER — visível apenas em mobile/tablet via CSS -->
        <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false"
          aria-controls="main-navigation">
          <i class="fas fa-bars"></i>
        </button>

      </div>

    </div>

  </nav>

  <main>
    <section id="projects-section" class="projects-page">

      <div class="projects-page-title">
        <h1>
          PROJETOS EM<br>
          DESTAQUE
        </h1>
      </div>

      <div class="project-showcase" aria-live="polite">

        <button class="project-nav project-nav-prev" type="button" aria-label="Projeto anterior">
          <i class="fas fa-chevron-left"></i>
        </button>

        <div class="project-showcase-content">

          <span class="project-counter" id="project-counter">1 / 12</span>

          <div class="project-showcase-header">

            <h2 class="project-showcase-title" id="project-showcase-title">
              Retratos Corporativos | Growth
            </h2>

            <button id="open-project-modal" class="project-details-btn">
              Ver detalhes
            </button>

          </div>

          <div class="project-photo-grid">
            <figure class="project-photo project-photo-wide">
              <img id="project-image-wide" src="img/growthlogo.webp" alt="Retratos Corporativos | Growth"
                loading="lazy">
            </figure>

            <figure class="project-photo project-photo-tall">
              <img id="project-image-tall" src="img/growthlogo.webp" alt="Retratos Corporativos | Growth"
                loading="lazy">
            </figure>

            <figure class="project-photo project-photo-square">
              <img id="project-image-square" src="img/growthlogo.webp" alt="Retratos Corporativos | Growth"
                loading="lazy">
            </figure>
          </div>

        </div>

        <button class="project-nav project-nav-next" type="button" aria-label="Próximo projeto">
          <i class="fas fa-chevron-right"></i>
        </button>

      </div>

      <div class="projects-red-frame">

        <div class="projects-grid-custom">

          <button class="project-card" data-project="1">
            <span class="project-name">Retratos Corporativos | Growth</span>
            <img src="img/growthlogo.webp" alt="Projeto 1" loading="lazy">
          </button>

          <button class="project-card" data-project="2">
            <span class="project-name">Lançamento de Produto | Ozoncare</span>
            <img src="img/ozoncare4.webp" alt="Projeto 2" loading="lazy">
          </button>

          <button class="project-card" data-project="3">
            <span class="project-name">Fotografia de Cardápio | Seu Conde</span>
            <img src="img/foto4.webp" alt="Projeto 3" loading="lazy">
          </button>

          <button class="project-card" data-project="4">
            <span class="project-name">Delas Summit | Sebrae</span>
            <img src="img/delassummitpreenchimento.webp" alt="Projeto 4" loading="lazy">
          </button>

          <button class="project-card" data-project="5">
            <span class="project-name">Produção de Conteúdo | Casa Inti Café</span>
            <img src="img/foto1tortinha.webp" alt="Projeto 5" loading="lazy">
          </button>


          <button class="project-card" data-project="6">
            <span class="project-name">Léo Stronda | Fábrica de Monstros</span>
            <img src="img/fabricademontros.webp" alt="Projeto 6" loading="lazy">
          </button>

          <button class="project-card" data-project="7">
            <span class="project-name">Editorial de Moda | Laura Brocco</span>
            <img src="img/colagemmariana3.webp" alt="Projeto 7" loading="lazy">
          </button>

          <button class="project-card" data-project="8">
            <span class="project-name">Campanha Institucional | Bar do Dragão</span>
            <img src="img/bardodragaodecima.webp" alt="Projeto 8" loading="lazy">
          </button>

          <button class="project-card" data-project="9">
            <span class="project-name">Videoclipe | FATO Duorum</span>
            <img src="img/fatoduarumcapa.webp" alt="Projeto 9" loading="lazy">
          </button>


          <button class="project-card" data-project="10">
            <span class="project-name">Med Plus Nova Geração | Philozon</span>
            <img src="img/medplusphilozon.webp" alt="Projeto 10" loading="lazy">
          </button>

          <button class="project-card" data-project="11">
            <span class="project-name">La Cocina Mescla | Encontro de grandes nomes da gastronomia</span>
            <img src="img/coccina.webp" alt="Projeto 9" loading="lazy">
          </button>

          <button class="project-card" data-project="12">
            <span class="project-name">Camvel Porto Belo | Vídeo Promocional</span>
            <img src="img/camvel.webp" alt="Projeto 10" loading="lazy">
          </button>

        </div>

      </div>

    </section>

    <section id="films-section" class="films-section">

      <div class="films-header">
        <h2>
          FILMES <br>
          AUTORAIS
        </h2>
      </div>

      <div class="films-gallery">

        <div class="film-block">

          <img src="img/cadafalsohorizontal.webp" alt="Cadafalso" loading="lazy">

          <button class="film-btn" data-film="cadafalso">
            SOBRE O FILME
          </button>

        </div>

        <div class="film-block etre-img">

          <img src="img/etrehorizontal.webp" alt="ÊTRE" class="etre-img" loading="lazy">

          <button class="film-btn" data-film="etre">
            SOBRE O FILME
          </button>

        </div>

      </div>

    </section>

    <!-- ========================= -->
    <!-- MODAL DOS PROJETOS -->
    <!-- ========================= -->

    <div class="project-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true">

      <div class="project-modal-container">

        <button class="project-modal-close" type="button" aria-label="Fechar detalhes do projeto">
          <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="project-modal-hero">
          <img id="modal-cover" src="" alt="">
          <div class="project-modal-hero-overlay"></div>
          <div class="project-modal-title-block">
            <span class="modal-category" id="modal-category"></span>
            <h2 id="modal-title"></h2>
            <p id="modal-summary"></p>
            <a id="modal-watch" class="modal-watch" href="#modal-videos">
              <i class="fa-solid fa-play"></i><span>Assistir vídeo</span>
            </a>
          </div>
        </div>

        <div class="project-modal-content">

          <div class="project-modal-main">
            <h3>Sobre o projeto</h3>
            <div id="modal-description"></div>

          </div>

          <aside class="project-modal-sidebar">

            <div class="modal-info">
              <i class="fa-regular fa-user"></i>
              <div>
              <span>Cliente</span>
              <strong id="modal-client"></strong>
              </div>

            </div>

            <div class="modal-info">
              <i class="fa-regular fa-folder"></i>
              <div>
              <span>Categoria</span>
              <strong id="modal-type"></strong>
              </div>

            </div>

            <div class="modal-info">
              <i class="fa-regular fa-calendar"></i>
              <div>
              <span>Ano</span>
              <strong id="modal-year"></strong>
              </div>

            </div>

            <div class="modal-info">
              <i class="fa-regular fa-star"></i>
              <div>
              <span>Serviços</span>
              <strong id="modal-services"></strong>
              </div>

            </div>

            <div class="modal-info modal-info--deliveries">
              <i class="fa-regular fa-paper-plane"></i>
              <div>
                <span>Entregas</span>
                <strong id="modal-deliveries"></strong>
              </div>
            </div>

          </aside>

        </div>

        <section class="modal-gallery-section">

          <h3>Galeria</h3>

          <div id="modal-gallery" class="modal-gallery">
          </div>

        </section>

        <section id="modal-videos" class="modal-video-section">
          <h3>Vídeos</h3>
          <div id="modal-videos-grid" class="modal-videos-grid"></div>
        </section>

        <section class="modal-bottom-grid">
          <div class="modal-behind-section">
            <h3>Bastidores</h3>
            <div id="modal-behind" class="modal-behind-gallery"></div>
          </div>
          <div class="modal-results-section">
            <h3>Resultados</h3>
            <ul id="modal-results"></ul>
          </div>
        </section>

        <div class="modal-project-navigation">
          <button id="modal-prev-project" type="button"><i class="fa-solid fa-arrow-left"></i><span>Projeto anterior</span></button>
          <i class="fa-solid fa-grip modal-project-navigation-icon" aria-hidden="true"></i>
          <button id="modal-next-project" type="button"><span>Próximo projeto</span><i class="fa-solid fa-arrow-right"></i></button>
        </div>

        <div class="modal-cta">
          <i class="fa-solid fa-clapperboard"></i>
          <div><span>Vamos criar juntos?</span><h3>Tem um projeto em mente?</h3><p>Fale com a gente e transforme sua ideia em algo memorável.</p></div>
          <a class="budget-btn" href="https://wa.me/5547999988082" target="_blank" rel="noopener noreferrer">Solicitar orçamento <i class="fa-solid fa-arrow-right"></i></a>
        </div>

      </div>

    </div>

    <!-- MODAL DOS FILMES -->

    <div class="film-modal">

      <div class="film-modal-content">

        <button class="film-close">&times;</button>

        <div class="film-poster">

          <img id="film-image-1" src="img/cadafalsohorizontal.webp" alt="">

          <div class="film-meta-bar">

            <span id="film-genre">DRAMA PSICOLÓGICO</span>
            <span>•</span>

            <span id="film-duration">14 MIN</span>
            <span>•</span>

            <span id="film-year">2024</span>
            <span>•</span>

            <span id="film-rating">14</span>
            <span>•</span>

            <span id="film-classification">CLASSIFICAÇÃO 14 ANOS</span>

          </div>

        </div>

        <div class="film-info">

          <div>

            <h4 class="film-section-title">
              SINOPSE
            </h4>

            <p id="film-description"></p>

          </div>

          <div id="film-line-tech" class="film-line"></div>

          <div id="film-tech-block">

            <h4 class="film-section-title">
              FICHA TÉCNICA
            </h4>

            <div class="film-tech-grid">

              <div>
                <span>DIREÇÃO</span>
                <p id="film-director"></p>
              </div>

              <div>
                <span>EDIÇÃO</span>
                <p id="film-editor"></p>
              </div>

              <div>
                <span>PRODUÇÃO</span>
                <p id="film-producer"></p>
              </div>

              <div>
                <span>ELENCO</span>
                <p id="film-cast"></p>
              </div>

              <div>
                <span>ROTEIRO</span>
                <p id="film-script"></p>
              </div>

              <div>
                <span>DURAÇÃO</span>
                <p id="film-runtime"></p>
              </div>

              <div>
                <span>FOTOGRAFIA</span>
                <p id="film-photo"></p>
              </div>

            </div>

          </div>

          <div id="film-line-bottom" class="film-line"></div>

          <div id="film-bottom-block" class="film-bottom">

            <div id="film-watch-block">

              <h4 class="film-section-title">
                ASSISTIR
              </h4>

              <a id="film-trailer" href="#" target="_blank" rel="noopener noreferrer" class="watch-btn">
                ASSISTIR TRAILER
              </a>

            </div>

            <div id="film-festivals-block">

              <h4 class="film-section-title">
                FESTIVAIS E EXIBIÇÕES
              </h4>

              <p id="film-festivals"></p>

            </div>

            <div id="film-platforms-block">
              <h4 class="film-section-title">
                ONDE ASSISTIR
              </h4>

              <p id="film-platforms"></p>
            </div>

          </div>

        </div>

      </div>

    </div>

  </main>

  <footer class="site-footer">
    <p>© 2026 FUKUIFILM. Todos os direitos reservados.</p>
  </footer>

</BaseLayout>

<script>
  import "../scripts/projects";
  import "../scripts/motion";
</script>
